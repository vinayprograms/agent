# Simple Memory Example
#
# Demonstrates basic semantic memory operations:
# - remember: Store insights
# - recall: Retrieve relevant memories
#
# Prerequisites:
# - Enable memory in agent.toml:
#   [memory]
#   enabled = true
#   [memory.embedding]
#   provider = "openai"
#
# Run: agent run examples/memory/simple-memory.agent

NAME simple-memory

# First, remember some facts
GOAL remember-facts """
Store some important facts in memory for later recall.

1. Use remember to store: "The project uses PostgreSQL 15 with JSONB for flexible schema"
2. Use remember to store: "User prefers vim keybindings and dark mode"
3. Use remember to store: "API rate limit is 100 requests per minute"

Confirm each memory was stored successfully.
"""

# Now recall those facts
GOAL recall-facts """
Test recalling the stored memories.

1. Use recall with query "database" - should find PostgreSQL info
2. Use recall with query "user preferences" - should find vim/dark mode info
3. Use recall with query "rate limits" - should find API limit info

Report what was found for each query.
"""

RUN main USING remember-facts, recall-facts
